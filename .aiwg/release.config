version: 1

project:
  name: roko-kb
  display_name: ROKO Knowledge Base
  repo_url: https://git.integrolabs.net/roko/roko-kb
  mirror_url: https://github.com/Roko-Network/roko-kb

version_policy:
  format: semver
  pattern: MAJOR.MINOR.PATCH
  tag_prefix: v
  channels:
    stable:
      require_announcement: false
      require_changelog: false
      require_uat: false
    rc:
      require_announcement: false
      require_changelog: false
      require_uat: false

gates:
  - name: local-pagenary-build
    hard_stop: true
    steps:
      - id: clean-install
        run: npm ci
      - id: list-tenants
        run: npm run list:tenants
      - id: build-docs
        run: npm run build:docs
      - id: validate-release
        run: npm run validate:release

  - name: aiwg-fortemi-artifact-index
    hard_stop: true
    steps:
      - id: rebuild-and-validate-aiwg-fortemi-export
        run: npm run index:aiwg

  - name: ci-green
    hard_stop: true
    tracker: gitea
    owner: roko
    repo: roko-kb
    timeout_seconds: 600
    poll_interval_seconds: 30
    required_workflows:
      - docs-build.yml
      - docs-deploy.yml

  - name: docs-artifacts
    hard_stop: true
    artifacts:
      - path: package.json
      - path: package-lock.json
      - path: tenants.json
      - path: scripts/validate-aiwg-fortemi-export.mjs
      - path: scripts/validate-migration.mjs
      - path: scripts/validate-pagenary-output.mjs
      - path: .gitea/workflows/docs-build.yml
      - path: .gitea/workflows/docs-deploy.yml
      - path: resources/publishing-and-search.md
      - path: .aiwg/architecture/adr/ADR-001-pagenary-fortemi-search.md
      - path: .aiwg/architecture/adr/ADR-002-fortemi-semantic-archive-roadmap.md
      - path: .aiwg/deployment/pagenary-publishing-runbook.md
      - path: .aiwg/deployment/production-target-decision.md

  - name: production-target-decision
    hard_stop: true
    review_diff:
      path: .aiwg/deployment/production-target-decision.md
      since_tag: latest-stable
      prompt: Confirm docs.roko.network host, base path, deployment trigger, and secret name before enabling live publishing.

policy:
  no_ai_attribution: true
  ci_green_before_done: true
  preserve_pre_release_announcements: true
  thank_external_reporters: false
